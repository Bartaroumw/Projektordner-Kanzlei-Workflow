# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/prisma/test.db*

# next.js
/.next/
/out/

# production
/build

# local databases and temporary files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
/tmp/
/temp/
/outputs/
/backups/
/storage/ordo-campus/
/storage/fibu-lohn/
/storage/profile-images/
*.tmp
*.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.integration.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
