generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id                           Int                                  @id @default(autoincrement())
  clientNumber                 String                               @unique
  name                         String
  processor                    String?
  reviewer                     String?
  team                         String? // Veraltet: nur zur verlustfreien Altdaten-Kompatibilität
  cadence                      String // Veraltet: neue Logik verwendet vatFilingPeriod
  vatFilingPeriod              String                               @default("Monatlich")
  managementName               String?
  processorUserId              Int?
  reviewerUserId               Int?
  managementUserId             Int?
  payrollPreparedByFirm        Boolean                              @default(false)
  payrollUserId                Int?
  payrollServiceStart          DateTime?
  payrollServiceEnd            DateTime?
  payrollResponsibilityNote    String?
  active                       Boolean                              @default(true)
  internalNote                 String?
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt
  annualProfiles               AnnualProfile[]
  periods                      AccountingPeriod[]
  customTasks                  CustomClientTask[]
  annualChecklists             AnnualChecklist[]
  customAnnualTasks            CustomAnnualTask[]
  payrollReconciliations       PayrollReconciliation[]
  vehicles                     ClientVehicle[]
  payrollResponsibilityHistory ClientPayrollResponsibilityHistory[]
  functionSeparationExceptions FunctionSeparationException[]
  processorUser                User?                                @relation("ClientProcessor", fields: [processorUserId], references: [id], onDelete: SetNull)
  reviewerUser                 User?                                @relation("ClientReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  managementUser               User?                                @relation("ClientManagement", fields: [managementUserId], references: [id], onDelete: SetNull)
  payrollUser                  User?                                @relation("ClientPayrollUser", fields: [payrollUserId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([active])
  @@index([processorUserId])
  @@index([reviewerUserId])
  @@index([managementUserId])
  @@index([payrollUserId])
}

model AnnualProfile {
  id                        Int      @id @default(autoincrement())
  clientId                  Int
  calendarYear              Int
  legalFormGroup            String
  profitDeterminationMethod String
  hasCashRegister           Boolean  @default(false)
  hasPayroll                Boolean  @default(false)
  hasFixedAssets            Boolean  @default(false)
  hasReceivablesPayables    Boolean  @default(false)
  hasLoans                  Boolean  @default(false)
  subjectToVat              Boolean  @default(false)
  hasPermanentExtension     Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  client                    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([clientId, calendarYear])
  @@index([calendarYear])
}

model TaskCategory {
  id            Int                @id @default(autoincrement())
  name          String             @unique
  description   String?
  sortOrder     Int                @default(0)
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  standardTasks StandardTask[]
  customTasks   CustomClientTask[]

  @@index([active, sortOrder])
}

model StandardTask {
  id                           Int                               @id @default(autoincrement())
  taskId                       String                            @unique
  active                       Boolean                           @default(true)
  checklistType                String
  categoryId                   Int
  subcategory                  String?
  title                        String
  workInstruction              String?
  reviewInstruction            String?
  mandatory                    Boolean                           @default(false)
  rhythm                       String
  executionMonth               Int?
  executionMonths              String?
  taskArea                     String?
  legalFormGroups              String
  profitDeterminationMethods   String
  cashCondition                String
  payrollCondition             String
  fixedAssetsCondition         String
  receivablesPayablesCondition String
  loansCondition               String
  vatCondition                 String
  permanentExtensionCondition  String
  knowledgeKey                 String?
  sortOrder                    Int                               @default(0)
  professionalVersion          String
  internalNote                 String?
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  category                     TaskCategory                      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  checklistTasks               ChecklistTask[]
  annualChecklistTasks         AnnualChecklistTask[]
  campusKnowledge              StandardTaskKnowledge?
  campusKnowledgeHistory       StandardTaskKnowledgeHistory[]
  campusAttachments            StandardTaskKnowledgeAttachment[]
  planningHistory              StandardTaskPlanningHistory[]
  payrollTopics                PayrollReconciliationTopic[]

  @@index([active, checklistType])
  @@index([categoryId, sortOrder])
}

model StandardTaskPlanningHistory {
  id                Int          @id @default(autoincrement())
  standardTaskId    Int
  actorUserId       Int
  actorNameSnapshot String
  changedArea       String
  previousValue     String?
  newValue          String?
  occurredAt        DateTime     @default(now())
  standardTask      StandardTask @relation(fields: [standardTaskId], references: [id], onDelete: Restrict)
  actorUser         User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([standardTaskId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model StandardTaskKnowledge {
  id                 Int                            @id @default(autoincrement())
  standardTaskId     Int                            @unique
  shortDescription   String?
  objective          String?
  processingGuidance String?
  firmStandard       String?
  reviewerGuidance   String?
  typicalErrors      String?
  internalHints      String?
  status             String                         @default("Entwurf")
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  standardTask       StandardTask                   @relation(fields: [standardTaskId], references: [id], onDelete: Restrict)
  links              StandardTaskKnowledgeLink[]
  history            StandardTaskKnowledgeHistory[]

  @@index([status, updatedAt])
}

model StandardTaskKnowledgeLink {
  id          Int                   @id @default(autoincrement())
  knowledgeId Int
  title       String
  url         String
  linkType    String
  description String?
  sortOrder   Int                   @default(0)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  knowledge   StandardTaskKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([knowledgeId, active, sortOrder])
  @@index([title])
}

model StandardTaskKnowledgeHistory {
  id                Int                   @id @default(autoincrement())
  knowledgeId       Int
  standardTaskId    Int
  actorUserId       Int
  actorNameSnapshot String
  changedArea       String
  description       String
  occurredAt        DateTime              @default(now())
  knowledge         StandardTaskKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Restrict)
  standardTask      StandardTask          @relation(fields: [standardTaskId], references: [id], onDelete: Restrict)
  actorUser         User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([standardTaskId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model StandardTaskKnowledgeAttachment {
  id               Int          @id @default(autoincrement())
  standardTaskId   Int
  displayName      String
  originalFileName String
  storedFileName   String       @unique
  storageKey       String       @unique
  fileExtension    String
  mimeType         String
  fileSizeBytes    Int
  description      String?
  status           String       @default("Aktiv")
  sortOrder        Int          @default(0)
  uploadedAt       DateTime     @default(now())
  uploadedByUserId Int
  archivedAt       DateTime?
  archivedByUserId Int?
  standardTask     StandardTask @relation(fields: [standardTaskId], references: [id], onDelete: Restrict)
  uploadedBy       User         @relation("CampusAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  archivedBy       User?        @relation("CampusAttachmentArchiver", fields: [archivedByUserId], references: [id], onDelete: Restrict)

  @@index([standardTaskId, status, sortOrder])
  @@index([uploadedByUserId, uploadedAt])
  @@index([archivedByUserId])
}

model AccountingPeriod {
  id                               Int                          @id @default(autoincrement())
  clientId                         Int
  calendarYear                     Int
  month                            Int
  periodLabel                      String
  checklistType                    String                       @default("Monat")
  processingStatus                 String                       @default("Offen")
  processorSnapshot                String?
  reviewerSnapshot                 String?
  managementNameSnapshot           String?
  processorUserId                  Int?
  reviewerUserId                   Int?
  managementUserId                 Int?
  currentActorInitials             String?
  submittedForReviewAt             DateTime?
  reviewStartedAt                  DateTime?
  returnedAt                       DateTime?
  lastReviewAt                     DateTime?
  lastStatusChangedAt              DateTime                     @default(now())
  generalNote                      String?
  checklistCreatedAt               DateTime                     @default(now())
  completedAt                      DateTime?
  createdAt                        DateTime                     @default(now())
  updatedAt                        DateTime                     @updatedAt
  profileLegalFormGroup            String
  profileProfitDeterminationMethod String
  profileHasCashRegister           Boolean
  profileHasPayroll                Boolean
  profileHasFixedAssets            Boolean
  profileHasReceivablesPayables    Boolean
  profileHasLoans                  Boolean
  profileSubjectToVat              Boolean
  profileHasPermanentExtension     Boolean
  client                           Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tasks                            ChecklistTask[]
  history                          WorkflowHistory[]
  functionSeparationExceptionId    Int?                         @unique
  processorUser                    User?                        @relation("PeriodProcessor", fields: [processorUserId], references: [id], onDelete: SetNull)
  reviewerUser                     User?                        @relation("PeriodReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  managementUser                   User?                        @relation("PeriodManagement", fields: [managementUserId], references: [id], onDelete: SetNull)
  functionSeparationException      FunctionSeparationException? @relation("PeriodFunctionSeparation", fields: [functionSeparationExceptionId], references: [id], onDelete: SetNull)
  payrollReconciliation            PayrollReconciliation?

  @@unique([clientId, calendarYear, month, checklistType])
  @@index([calendarYear, month, processingStatus])
  @@index([clientId, updatedAt])
  @@index([processorUserId])
  @@index([reviewerUserId])
  @@index([managementUserId])
}

model ChecklistTask {
  id                           Int                    @id @default(autoincrement())
  periodId                     Int
  standardTaskId               Int?
  customClientTaskId           Int?
  sourceTaskId                 Int?
  taskIdSnapshot               String
  categorySnapshot             String
  categorySortOrder            Int                    @default(0)
  subcategorySnapshot          String?
  titleSnapshot                String
  workInstructionSnapshot      String?
  reviewInstructionSnapshot    String?
  mandatorySnapshot            Boolean                @default(false)
  sortOrderSnapshot            Int?
  professionalVersionSnapshot  String?
  origin                       String
  status                       String                 @default("Offen")
  processingNote               String?
  carryProcessingNote          Boolean                @default(false)
  carriedNoteSourceTaskId      Int?
  carriedNoteSourcePeriodLabel String?
  processedAt                  DateTime?
  processorInitials            String?
  notApplicableReason          String?
  transferTargetYear           Int?
  transferTargetMonth          Int?
  transferReason               String?
  transferActorName            String?
  transferExpectedAction       String?
  transferredAt                DateTime?
  reviewStatus                 String                 @default("Nicht geprüft")
  reviewerInitials             String?
  reviewNote                   String?
  reviewedAt                   DateTime?
  reviewIssueCreatedAt         DateTime?
  reviewIssueStatus            String?
  reviewIssueRaisedByUserId    Int?
  reviewIssueRaisedByName      String?
  reviewIssueRaisedByRole      String?
  reviewIssueDirectedToUserId  Int?
  reviewIssueDirectedToName    String?
  reviewIssueDirectedToRole    String?
  processorResponse            String?
  respondedBy                  String?
  respondedAt                  DateTime?
  finalReviewedAt              DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  period                       AccountingPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  standardTask                 StandardTask?          @relation(fields: [standardTaskId], references: [id], onDelete: SetNull)
  customClientTask             CustomClientTask?      @relation(fields: [customClientTaskId], references: [id], onDelete: SetNull)
  sourceTask                   ChecklistTask?         @relation("TaskTransfer", fields: [sourceTaskId], references: [id], onDelete: Restrict)
  transferredTasks             ChecklistTask[]        @relation("TaskTransfer")
  history                      WorkflowHistory[]
  annualDerivedTasks           AnnualChecklistTask[]  @relation("AnnualTaskMonthlySource")
  payrollReconciliation        PayrollReconciliation?

  @@unique([periodId, sourceTaskId])
  @@index([periodId, categorySortOrder, sortOrderSnapshot])
  @@index([standardTaskId])
  @@index([customClientTaskId])
  @@index([sourceTaskId])
}

model WorkflowHistory {
  id                            Int                          @id @default(autoincrement())
  periodId                      Int
  checklistTaskId               Int?
  eventType                     String
  occurredAt                    DateTime                     @default(now())
  actorInitials                 String?
  actorUserId                   Int?
  actorNameSnapshot             String?
  actorRoleSnapshot             String?
  description                   String
  previousValue                 String?
  newValue                      String?
  reason                        String?
  period                        AccountingPeriod             @relation(fields: [periodId], references: [id], onDelete: Restrict)
  checklistTask                 ChecklistTask?               @relation(fields: [checklistTaskId], references: [id], onDelete: Restrict)
  actorUser                     User?                        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  functionSeparationExceptionId Int?
  functionSeparationException   FunctionSeparationException? @relation("MonthlyHistoryFunctionSeparation", fields: [functionSeparationExceptionId], references: [id], onDelete: SetNull)

  @@index([periodId, occurredAt])
  @@index([checklistTaskId, occurredAt])
  @@index([actorUserId])
}

model User {
  id                                   Int                                  @id @default(autoincrement())
  fullName                             String
  username                             String                               @unique
  email                                String?                              @unique
  passwordHash                         String
  active                               Boolean                              @default(true)
  shortLabel                           String?
  lastLoginAt                          DateTime?
  passwordChangedAt                    DateTime?
  mustChangePassword                   Boolean                              @default(true)
  sessionVersion                       Int                                  @default(1)
  createdAt                            DateTime                             @default(now())
  updatedAt                            DateTime                             @updatedAt
  roles                                UserRole[]
  sessions                             Session[]
  processorClients                     Client[]                             @relation("ClientProcessor")
  reviewerClients                      Client[]                             @relation("ClientReviewer")
  managementClients                    Client[]                             @relation("ClientManagement")
  payrollClients                       Client[]                             @relation("ClientPayrollUser")
  processorPeriods                     AccountingPeriod[]                   @relation("PeriodProcessor")
  reviewerPeriods                      AccountingPeriod[]                   @relation("PeriodReviewer")
  managementPeriods                    AccountingPeriod[]                   @relation("PeriodManagement")
  historyEntries                       WorkflowHistory[]
  annualProcessorChecklists            AnnualChecklist[]                    @relation("AnnualProcessor")
  annualReviewerChecklists             AnnualChecklist[]                    @relation("AnnualReviewer")
  annualManagementChecklists           AnnualChecklist[]                    @relation("AnnualManagement")
  annualHistoryEntries                 AnnualWorkflowHistory[]
  createdAnnualTasks                   AnnualChecklistTask[]                @relation("AnnualTaskCreator")
  releasedAnnualChecklists             AnnualChecklist[]                    @relation("AnnualReleaseUser")
  approvedFunctionSeparationExceptions FunctionSeparationException[]        @relation("FunctionSeparationApprover")
  assignedFunctionSeparationExceptions FunctionSeparationException[]        @relation("FunctionSeparationAssigned")
  campusKnowledgeHistory               StandardTaskKnowledgeHistory[]
  standardTaskPlanningHistory          StandardTaskPlanningHistory[]
  uploadedCampusAttachments            StandardTaskKnowledgeAttachment[]    @relation("CampusAttachmentUploader")
  archivedCampusAttachments            StandardTaskKnowledgeAttachment[]    @relation("CampusAttachmentArchiver")
  createdPayrollTopics                 PayrollReconciliationTopic[]         @relation("PayrollTopicCreator")
  payrollReconciliations               PayrollReconciliation[]              @relation("PayrollReconciliationAssignee")
  processedPayrollItems                PayrollReconciliationItem[]          @relation("PayrollItemProcessor")
  payrollQuestionsSent                 PayrollReconciliationQuestion[]      @relation("PayrollQuestionSender")
  payrollQuestionsReceived             PayrollReconciliationQuestion[]      @relation("PayrollQuestionRecipient")
  uploadedPayrollDocuments             PayrollDocumentReference[]           @relation("PayrollDocumentUploader")
  archivedPayrollDocuments             PayrollDocumentReference[]           @relation("PayrollDocumentArchiver")
  createdVehicles                      ClientVehicle[]                      @relation("VehicleCreator")
  updatedVehicles                      ClientVehicle[]                      @relation("VehicleUpdater")
  createdVehicleChanges                ClientVehicleChange[]                @relation("VehicleChangeCreator")
  payrollHistoryEntries                PayrollReconciliationHistory[]
  changedPayrollResponsibilities       ClientPayrollResponsibilityHistory[] @relation("PayrollResponsibilityChanger")
  assignedPayrollResponsibilities      ClientPayrollResponsibilityHistory[] @relation("PayrollResponsibilityAssignee")
  processorPayrollReconciliations      PayrollReconciliation[]              @relation("PayrollReconciliationProcessor")
  reviewerPayrollReconciliations       PayrollReconciliation[]              @relation("PayrollReconciliationReviewer")
  payrollTopicHistory                  PayrollReconciliationTopicHistory[]
  createdPayrollPositions              PayrollReconciliationPosition[]      @relation("PayrollPositionCreator")
  updatedPayrollPositions              PayrollReconciliationPosition[]      @relation("PayrollPositionUpdater")

  @@index([active, fullName])
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId Int
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model Session {
  id             Int      @id @default(autoincrement())
  tokenHash      String   @unique
  userId         Int
  sessionVersion Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model CustomClientTask {
  id              Int             @id @default(autoincrement())
  clientId        Int
  title           String
  description     String?
  categoryId      Int
  active          Boolean         @default(true)
  taskType        String
  validFrom       DateTime
  validUntil      DateTime?
  executionYear   Int?
  executionMonth  Int?
  executionRhythm String?
  executionMonths String?
  taskArea        String?
  processor       String?
  reviewer        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  category        TaskCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  checklistTasks  ChecklistTask[]

  @@index([clientId, active, taskType])
  @@index([categoryId])
}

model TaskImportHistory {
  id                   Int      @id @default(autoincrement())
  originalFileName     String
  importedAt           DateTime @default(now())
  professionalVersion  String?
  createdCount         Int
  updatedCount         Int
  unchangedCount       Int
  deactivatedCount     Int
  errorRowCount        Int
  createdCategoryCount Int
  status               String
}

model TaskImportPreview {
  id               String   @id
  originalFileName String
  fileHash         String
  previewJson      String
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([expiresAt])
}

model AnnualChecklist {
  id                            Int                          @id @default(autoincrement())
  clientId                      Int
  fiscalYear                    Int
  closingDate                   DateTime
  legalFormSnapshot             String
  profitDeterminationSnapshot   String
  processorUserId               Int
  reviewerUserId                Int
  managementUserId              Int
  processorNameSnapshot         String
  reviewerNameSnapshot          String
  managementNameSnapshot        String
  status                        String                       @default("Offen")
  generalNote                   String?
  submittedForReviewAt          DateTime?
  reviewStartedAt               DateTime?
  returnedAt                    DateTime?
  professionallyCompletedAt     DateTime?
  submittedForReleaseAt         DateTime?
  releasedAt                    DateTime?
  releaseUserId                 Int?
  releaseNameSnapshot           String?
  releaseNote                   String?
  functionSeparationExceptionId Int?                         @unique
  completedAt                   DateTime?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  client                        Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  processorUser                 User                         @relation("AnnualProcessor", fields: [processorUserId], references: [id], onDelete: Restrict)
  reviewerUser                  User                         @relation("AnnualReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  managementUser                User                         @relation("AnnualManagement", fields: [managementUserId], references: [id], onDelete: Restrict)
  releaseUser                   User?                        @relation("AnnualReleaseUser", fields: [releaseUserId], references: [id], onDelete: SetNull)
  tasks                         AnnualChecklistTask[]
  history                       AnnualWorkflowHistory[]
  functionSeparationException   FunctionSeparationException? @relation("AnnualFunctionSeparation", fields: [functionSeparationExceptionId], references: [id], onDelete: SetNull)

  @@unique([clientId, fiscalYear])
  @@index([fiscalYear, status])
  @@index([processorUserId])
  @@index([reviewerUserId])
  @@index([managementUserId])
}

model AnnualChecklistTask {
  id                          Int                     @id @default(autoincrement())
  annualChecklistId           Int
  standardTaskId              Int?
  customAnnualTaskId          Int?
  sourceMonthlyTaskId         Int?
  createdByUserId             Int?
  taskIdSnapshot              String
  categorySnapshot            String
  categorySortOrder           Int                     @default(0)
  titleSnapshot               String
  workInstructionSnapshot     String?
  reviewInstructionSnapshot   String?
  mandatorySnapshot           Boolean                 @default(false)
  sortOrderSnapshot           Int                     @default(0)
  professionalVersionSnapshot String?
  origin                      String
  status                      String                  @default("Offen")
  processingNote              String?
  notApplicableReason         String?
  processedByName             String?
  processedAt                 DateTime?
  reviewStatus                String                  @default("Nicht geprüft")
  reviewNote                  String?
  reviewedByName              String?
  reviewedAt                  DateTime?
  reviewIssueCreatedAt        DateTime?
  processorResponse           String?
  respondedByName             String?
  respondedAt                 DateTime?
  managementNote              String?
  sourceMonthLabel            String?
  sourceNoteSnapshot          String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  annualChecklist             AnnualChecklist         @relation(fields: [annualChecklistId], references: [id], onDelete: Restrict)
  standardTask                StandardTask?           @relation(fields: [standardTaskId], references: [id], onDelete: SetNull)
  customAnnualTask            CustomAnnualTask?       @relation(fields: [customAnnualTaskId], references: [id], onDelete: SetNull)
  sourceMonthlyTask           ChecklistTask?          @relation("AnnualTaskMonthlySource", fields: [sourceMonthlyTaskId], references: [id], onDelete: SetNull)
  createdByUser               User?                   @relation("AnnualTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  history                     AnnualWorkflowHistory[]

  @@index([annualChecklistId, categorySortOrder, sortOrderSnapshot])
  @@index([standardTaskId])
  @@index([customAnnualTaskId])
  @@index([sourceMonthlyTaskId])
}

model AnnualWorkflowHistory {
  id                            Int                          @id @default(autoincrement())
  annualChecklistId             Int
  annualChecklistTaskId         Int?
  eventType                     String
  occurredAt                    DateTime                     @default(now())
  actorUserId                   Int?
  actorNameSnapshot             String
  actorRoleSnapshot             String
  description                   String
  previousValue                 String?
  newValue                      String?
  reason                        String?
  functionSeparationExceptionId Int?
  annualChecklist               AnnualChecklist              @relation(fields: [annualChecklistId], references: [id], onDelete: Restrict)
  annualChecklistTask           AnnualChecklistTask?         @relation(fields: [annualChecklistTaskId], references: [id], onDelete: Restrict)
  actorUser                     User?                        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  functionSeparationException   FunctionSeparationException? @relation("AnnualHistoryFunctionSeparation", fields: [functionSeparationExceptionId], references: [id], onDelete: SetNull)

  @@index([annualChecklistId, occurredAt])
  @@index([annualChecklistTaskId, occurredAt])
  @@index([actorUserId])
}

model CustomAnnualTask {
  id             Int                   @id @default(autoincrement())
  clientId       Int
  title          String
  description    String?
  category       String
  active         Boolean               @default(true)
  validFromYear  Int
  validUntilYear Int?
  mandatory      Boolean               @default(false)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  checklistTasks AnnualChecklistTask[]

  @@index([clientId, active, validFromYear])
}

model FunctionSeparationException {
  id                     Int                     @id @default(autoincrement())
  clientId               Int
  fiscalYear             Int?
  assignedUserId         Int
  equalRoles             String
  scope                  String
  reason                 String
  approvedByUserId       Int
  approvedByNameSnapshot String
  approvedByRoleSnapshot String
  confirmed              Boolean
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedUser           User                    @relation("FunctionSeparationAssigned", fields: [assignedUserId], references: [id], onDelete: Restrict)
  approvedByUser         User                    @relation("FunctionSeparationApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  accountingPeriods      AccountingPeriod[]      @relation("PeriodFunctionSeparation")
  annualChecklists       AnnualChecklist[]       @relation("AnnualFunctionSeparation")
  monthlyHistory         WorkflowHistory[]       @relation("MonthlyHistoryFunctionSeparation")
  annualHistory          AnnualWorkflowHistory[] @relation("AnnualHistoryFunctionSeparation")

  @@index([clientId, fiscalYear, active])
  @@index([assignedUserId])
  @@index([approvedByUserId])
}

model PayrollReconciliationTopic {
  id                     Int                                 @id @default(autoincrement())
  key                    String                              @unique
  title                  String
  shortDescription       String?
  reviewQuestion         String
  sortOrder              Int                                 @default(0)
  status                 String                              @default("Aktiv")
  validFrom              DateTime
  validUntil             DateTime?
  topicType              String
  vehicleRelated         Boolean                             @default(false)
  followUpAllowed        Boolean                             @default(false)
  campusStandardTaskId   Int?
  requiredStandardFields String
  requiredDocumentTypes  String
  notes                  String?
  createdByUserId        Int
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  createdBy              User                                @relation("PayrollTopicCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  campusStandardTask     StandardTask?                       @relation(fields: [campusStandardTaskId], references: [id], onDelete: SetNull)
  reconciliationItems    PayrollReconciliationItem[]
  history                PayrollReconciliationTopicHistory[]

  @@index([status, validFrom, validUntil, sortOrder])
  @@index([campusStandardTaskId])
}

model ClientPayrollResponsibilityHistory {
  id                      Int       @id @default(autoincrement())
  clientId                Int
  payrollPreparedByFirm   Boolean
  payrollUserId           Int?
  payrollUserNameSnapshot String?
  validFrom               DateTime?
  validUntil              DateTime?
  note                    String?
  changedByUserId         Int
  createdAt               DateTime  @default(now())
  client                  Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  payrollUser             User?     @relation("PayrollResponsibilityAssignee", fields: [payrollUserId], references: [id], onDelete: Restrict)
  changedBy               User      @relation("PayrollResponsibilityChanger", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@index([payrollUserId])
  @@index([changedByUserId])
}

model PayrollReconciliationTopicHistory {
  id                Int                        @id @default(autoincrement())
  topicId           Int
  actorUserId       Int
  actorNameSnapshot String
  action            String
  summary           String
  previousValue     String?
  newValue          String?
  occurredAt        DateTime                   @default(now())
  topic             PayrollReconciliationTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  actorUser         User                       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([topicId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model PayrollReconciliation {
  id                      Int                             @id @default(autoincrement())
  clientId                Int
  accountingYear          Int
  accountingMonth         Int
  payrollYear             Int
  payrollMonth            Int
  accountingPeriodId      Int                             @unique
  checklistTaskId         Int                             @unique
  processorUserId         Int?
  processorNameSnapshot   String?
  reviewerUserId          Int?
  reviewerNameSnapshot    String?
  payrollUserId           Int
  payrollUserNameSnapshot String
  accountingStatus        String                          @default("Offen")
  payrollStatus           String                          @default("Neu")
  transferredAt           DateTime?
  seenAt                  DateTime?
  completedAt             DateTime?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  client                  Client                          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  accountingPeriod        AccountingPeriod                @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  checklistTask           ChecklistTask                   @relation(fields: [checklistTaskId], references: [id], onDelete: Restrict)
  processorUser           User?                           @relation("PayrollReconciliationProcessor", fields: [processorUserId], references: [id], onDelete: Restrict)
  reviewerUser            User?                           @relation("PayrollReconciliationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  payrollUser             User                            @relation("PayrollReconciliationAssignee", fields: [payrollUserId], references: [id], onDelete: Restrict)
  items                   PayrollReconciliationItem[]
  questions               PayrollReconciliationQuestion[]
  history                 PayrollReconciliationHistory[]

  @@unique([clientId, payrollYear, payrollMonth])
  @@index([payrollUserId, payrollStatus, payrollYear, payrollMonth])
  @@index([clientId, accountingYear, accountingMonth])
}

model PayrollReconciliationItem {
  id                        Int                             @id @default(autoincrement())
  reconciliationId          Int
  sourceTopicId             Int
  topicKeySnapshot          String
  topicTitleSnapshot        String
  descriptionSnapshot       String?
  reviewQuestionSnapshot    String
  sortOrderSnapshot         Int                             @default(0)
  topicTypeSnapshot         String
  vehicleRelatedSnapshot    Boolean                         @default(false)
  requiredFieldsSnapshot    String
  requiredDocumentsSnapshot String
  status                    String                          @default("Noch nicht geprüft")
  matterPresent             String                          @default("Noch offen")
  payrollProcessingStatus   String                          @default("Offen")
  payrollProcessedAt        DateTime?
  processedByUserId         Int?
  reviewedAt                DateTime?
  fullyTransferredAt        DateTime?
  note                      String?
  detailsJson               String?
  missingDocumentType       String?
  documentToFollow          Boolean                         @default(false)
  followUpReason            String?
  expectedFollowUpAt        DateTime?
  followUpAllowed           Boolean                         @default(false)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  reconciliation            PayrollReconciliation           @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  sourceTopic               PayrollReconciliationTopic      @relation(fields: [sourceTopicId], references: [id], onDelete: Restrict)
  processedBy               User?                           @relation("PayrollItemProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull)
  documents                 PayrollDocumentReference[]
  positions                 PayrollReconciliationPosition[]
  questions                 PayrollReconciliationQuestion[]
  vehicleChanges            ClientVehicleChange[]
  history                   PayrollReconciliationHistory[]

  @@unique([reconciliationId, sourceTopicId])
  @@index([reconciliationId, sortOrderSnapshot])
  @@index([sourceTopicId])
}

model PayrollReconciliationPosition {
  id                       Int                          @id @default(autoincrement())
  reconciliationItemId     Int
  positionType             String                       @default("Einzelposition")
  title                    String
  caseCount                Int                          @default(1)
  totalAmountCents         Int?
  period                   String?
  summary                  String?
  peopleJson               String?
  detailsJson              String?
  requiredListType         String?
  requiredListDocumentName String?
  status                   String                       @default("Entwurf")
  duplicatedFromId         Int?
  createdByUserId          Int
  updatedByUserId          Int
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  archivedAt               DateTime?
  reconciliationItem       PayrollReconciliationItem    @relation(fields: [reconciliationItemId], references: [id], onDelete: Restrict)
  duplicatedFrom           PayrollReconciliationPosition? @relation("PayrollPositionDuplicate", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates               PayrollReconciliationPosition[] @relation("PayrollPositionDuplicate")
  createdBy                User                         @relation("PayrollPositionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                User                         @relation("PayrollPositionUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  documents                PayrollDocumentReference[]
  history                  PayrollReconciliationHistory[]

  @@index([reconciliationItemId, status, createdAt])
  @@index([duplicatedFromId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model PayrollDocumentReference {
  id                   Int                            @id @default(autoincrement())
  reconciliationItemId Int
  positionId           Int?
  questionId           Int?
  displayName          String
  originalFileName     String
  storedFileName       String                         @unique
  storageKey           String                         @unique
  fileExtension        String
  mimeType             String
  fileSizeBytes        Int
  documentType         String
  description          String?
  status               String                         @default("Aktiv")
  uploadedAt           DateTime                       @default(now())
  uploadedByUserId     Int
  archivedAt           DateTime?
  archivedByUserId     Int?
  reconciliationItem   PayrollReconciliationItem      @relation(fields: [reconciliationItemId], references: [id], onDelete: Restrict)
  position             PayrollReconciliationPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  question             PayrollReconciliationQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  uploadedBy           User                           @relation("PayrollDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  archivedBy           User?                          @relation("PayrollDocumentArchiver", fields: [archivedByUserId], references: [id], onDelete: Restrict)

  @@index([reconciliationItemId, status])
  @@index([positionId, status])
  @@index([questionId])
}

model PayrollReconciliationQuestion {
  id                   Int                        @id @default(autoincrement())
  reconciliationId     Int
  reconciliationItemId Int
  senderUserId         Int
  recipientUserId      Int
  senderDepartment     String
  recipientDepartment  String
  message              String
  status               String                     @default("Offen beim Rechnungswesen")
  answer               String?
  createdAt            DateTime                   @default(now())
  answeredAt           DateTime?
  completedAt          DateTime?
  reconciliation       PayrollReconciliation      @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  reconciliationItem   PayrollReconciliationItem  @relation(fields: [reconciliationItemId], references: [id], onDelete: Restrict)
  sender               User                       @relation("PayrollQuestionSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  recipient            User                       @relation("PayrollQuestionRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  documents            PayrollDocumentReference[]

  @@index([recipientUserId, status, createdAt])
  @@index([reconciliationId, reconciliationItemId])
}

model ClientVehicle {
  id                    Int                            @id @default(autoincrement())
  clientId              Int
  referenceNumber       String?
  description           String
  licensePlate          String?
  userName              String
  userFunction          String
  contractAvailable     Boolean                        @default(false)
  contractReference     String?
  contractDate          DateTime?
  ownershipType         String
  grossListPriceCents   Int?
  documentReference     String?
  onePercentRule        Boolean                        @default(false)
  logbook               Boolean                        @default(false)
  commuteUse            Boolean                        @default(false)
  accountingAccount     String?
  accountingBasis       String?
  accountingExplanation String?
  validFrom             DateTime
  validUntil            DateTime?
  status                String                         @default("Aktiv")
  note                  String?
  createdByUserId       Int
  updatedByUserId       Int
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  client                Client                         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy             User                           @relation("VehicleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy             User                           @relation("VehicleUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  changes               ClientVehicleChange[]
  history               PayrollReconciliationHistory[]

  @@unique([clientId, referenceNumber])
  @@index([clientId, status, validFrom])
}

model ClientVehicleChange {
  id                   Int                        @id @default(autoincrement())
  vehicleId            Int
  reconciliationItemId Int?
  changeType           String
  effectiveFrom        DateTime
  summary              String
  previousValueJson    String?
  newValueJson         String?
  createdByUserId      Int
  createdAt            DateTime                   @default(now())
  vehicle              ClientVehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  reconciliationItem   PayrollReconciliationItem? @relation(fields: [reconciliationItemId], references: [id], onDelete: SetNull)
  createdBy            User                       @relation("VehicleChangeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([vehicleId, effectiveFrom])
  @@index([reconciliationItemId])
}

model PayrollReconciliationHistory {
  id                   Int                        @id @default(autoincrement())
  reconciliationId     Int
  reconciliationItemId Int?
  positionId           Int?
  vehicleId            Int?
  actorUserId          Int
  actorNameSnapshot    String
  actorDepartment      String
  action               String
  summary              String
  previousValue        String?
  newValue             String?
  occurredAt           DateTime                   @default(now())
  reconciliation       PayrollReconciliation      @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  reconciliationItem   PayrollReconciliationItem? @relation(fields: [reconciliationItemId], references: [id], onDelete: Restrict)
  position             PayrollReconciliationPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  vehicle              ClientVehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  actorUser            User                       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([reconciliationId, occurredAt])
  @@index([reconciliationItemId, occurredAt])
  @@index([positionId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([actorUserId, occurredAt])
}
